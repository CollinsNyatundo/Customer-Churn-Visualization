# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_PIPELINE=churn-data-pipeline
MLFLOW_EXPERIMENT_MODEL=churn-model
MLFLOW_REGISTERED_MODEL_NAME=ChurnClassifier

# ── Prefect ───────────────────────────────────────────────────────────────────
PREFECT_API_URL=http://localhost:4200/api

# ── Source mode toggles ───────────────────────────────────────────────────────
# Set to true to use real API-backed sources instead of synthetic generators
USE_CRM_API=false
USE_SUPPORT_API=false
USE_BILLING_API=false

# Set to true to append real-world CSV datasets (download required — see docs)
USE_KAGGLE=false
USE_BANK=false

# ── EspoCRM (CRM API source) ──────────────────────────────────────────────────
ESPOCRM_URL=http://localhost:8080
ESPOCRM_API_KEY=your-espocrm-api-key

# ── Zammad (Support API source) ───────────────────────────────────────────────
ZAMMAD_URL=http://localhost:3000
ZAMMAD_API_TOKEN=your-zammad-api-token

# ── Billing (NovaBilling or Lago) ─────────────────────────────────────────────
BILLING_PROVIDER=novabilling          # or: lago
NOVABILLING_URL=http://localhost:4000
NOVABILLING_API_KEY=your-novabilling-key
LAGO_URL=http://localhost:3000
LAGO_API_KEY=your-lago-key

# ── FastAPI auth ──────────────────────────────────────────────────────────────
# Comma-separated API keys. Omit or leave empty for dev bypass.
API_KEYS=

# ── Alerts ────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_EMAIL_FROM=alerts@yourcompany.com
ALERT_EMAIL_TO=team@yourcompany.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.com
SMTP_PASSWORD=your-app-password

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=      # e.g. http://localhost:4317 (Jaeger/Tempo)
OTEL_SERVICE_NAME=churn-prediction

# ── Reproducibility ───────────────────────────────────────────────────────────
SYNTHETIC_SEED=42
MODEL_TEST_SIZE=0.2
MODEL_CV_FOLDS=5
MODEL_RANDOM_STATE=42

# ── App ───────────────────────────────────────────────────────────────────────
DASH_HOST=0.0.0.0
DASH_PORT=8050
DASH_DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=text    # or: json

# ── Environment mode ──────────────────────────────────────────────────────────
# Set to "production" to enforce auth, strict CORS, and hard startup failures
ENV=development

# ── Feature engineering ───────────────────────────────────────────────────────
# Risk tier thresholds (overrides hardcoded values)
RISK_TIER_HIGH=0.60
RISK_TIER_MEDIUM=0.30

# MLflow offline mode — set to true to skip tracking (useful in CI/CD)
MLFLOW_OFFLINE=false

# ── Shadow deployment (champion/challenger) ───────────────────────────────────
# Fraction of traffic routed to challenger (Staging) model for comparison.
# 0.0 = disabled (default). 0.1 = 10% of predictions also scored by challenger.
SHADOW_DEPLOYMENT_SPLIT=0.0

# ── Performance monitoring ─────────────────────────────────────────────────────
PERFORMANCE_ALERT_AUC_THRESHOLD=0.90
PERFORMANCE_ALERT_RECALL_THRESHOLD=0.80
